<?xml version="1.0" encoding="UTF-8"?>
<!--
  itel RS4 (S666LN, MT6789 / Helio G99) - local manifest, LineageOS 23.2 (Android 16), built as AICP w16.2.
  Bring-up stage 1: LineageOS-official MediaTek support only. Our own repos
  (device/itel/S666LN, -kernel, kernel/itel/S666LN, vendor/itel/S666LN) are
  added once their lineage-23.2 branches exist.

  Clean-room rule unchanged: nothing from KimelaZX or MillenniumOSS.

    hardware/mediatek             PRODUCT_SOONG_NAMESPACES; on 23.2 it also
                                  carries wlan/ (libwifi-hal-mt66xx), which on
                                  A13 needed crDroid's separate wlan repo
    device/mediatek/sepolicy_vndr sepolicy/vendor/*.te reference its types
-->
<manifest>
  <remote name="los" fetch="https://github.com/LineageOS" clone-depth="1" />

  <project path="hardware/mediatek" name="android_hardware_mediatek"
           remote="los" revision="lineage-23.2" />

  <project path="device/mediatek/sepolicy_vndr" name="android_device_mediatek_sepolicy_vndr"
           remote="los" revision="lineage-23.2" />

  <remote name="riza" fetch="https://github.com/riza220201" clone-depth="1" />

  <!-- Kernel package: dtb/, dtbo.img, 198 vendor_dlkm + 206 vendor_boot modules
       (197 + 205 byte-identical to stock rev 28; the two exceptions are named in
       its README). The A13 branch is the start point; lineage-23.2 is branched
       locally and gets prebuilt/ from import-kernel.sh (Neutron-built v9 vanilla).
       NOT ~/kernelpkg-work: that checkout is gutted on purpose (SUPERSEDED-DO-NOT-USE). -->
  <project path="device/itel/S666LN-kernel" name="device_itel_S666LN-kernel"
           remote="riza" revision="lineage-20.0" />

  <!-- Kernel source (plain GKI android12-5.10 + s666ln_defconfig). Not compiled:
       the kernel is imported. Present because LineageOS's generated_kernel_includes
       runs headers_install on TARGET_KERNEL_SOURCE even with a prebuilt kernel
       (Knowledge: build-system gotchas, Advan 09-29); re-check on 23.2. -->
  <project path="kernel/itel/S666LN" name="kernel_itel_S666LN"
           remote="riza" revision="lineage-20.0" clone-depth="1" />

  <!-- device/itel/S666LN is NOT a repo project: it is a git worktree of
       ~/itel-rs4-devicetree/device_itel_S666LN on branch lineage-23.2.
       vendor/itel/S666LN is regenerated from stock rev 28 (.build/work/vendor). -->
</manifest>
